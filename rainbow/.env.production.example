# Deployment target (the separate Networked IPFS server, not EVM.now).
DOCKER_REGISTRY_USERNAME=
DEPLOY_HOST=
KAMAL_REGISTRY_PASSWORD=
IPFS_GATEWAY_HOST=ipfs-gw.evm.now

# A fixed-size filesystem mounted by ops/provision-data-volume.sh.
# RAINBOW_VOLUME=/home/ipfs/rainbow
RAINBOW_CONTAINER_CPUS=4
RAINBOW_CONTAINER_MEMORY=6g
RAINBOW_NOFILE=65535

# Delegated provider routing; DHT must remain disabled.
RAINBOW_HTTP_ROUTERS=auto
RAINBOW_HTTP_ROUTERS_TIMEOUT=10s
RAINBOW_ROUTING_TIMEOUT=15s
RAINBOW_RETRIEVAL_TIMEOUT=15s

# RAINBOW_ORIGIN_TOKEN is a secret: keep it only in .kamal/secrets and the
# Cloudflare Worker secret of the same name, never in this file.
